{
  "name": "finance-tracker",
  "version": "1.3.0",
  "private": true,
  "description": "Personal finance tracker (Plaid sync + budget planning), packaged as a desktop app.",
  "license": "MIT",
  "author": {
    "name": "Minsoo Kim",
    "email": "minsookim612@gmail.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "dist": "electron-builder",
    "install-desktop": "cp dist/Finance\\ Tracker-*.AppImage ~/Applications/FinanceTracker.AppImage && chmod +x ~/Applications/FinanceTracker.AppImage && echo 'Installed -> ~/Applications/FinanceTracker.AppImage (launcher icon now points at this build)'"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.9",
    "express": "^4.18.2",
    "pdfjs-dist": "^6.2.108",
    "plaid": "^26.0.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.minsookim.financetracker",
    "productName": "Finance Tracker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "index.html",
      "script.js",
      "styles.css",
      "node_modules/**/*"
    ],
    "extraResources": [],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Finance",
      "icon": "build/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "avocado612",
      "repo": "personal-finance-tracker",
      "private": true
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
